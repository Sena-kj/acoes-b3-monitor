# ============================================================
# acoes-b3-monitor — configuracao do usuario
# ============================================================
# INSTRUCOES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores marcados como <obrigatorio>
#   3. NUNCA commite o .env no git (ja esta no .gitignore)
# ============================================================

# ----------------------------------------------------------
# Ativos monitorados
# ----------------------------------------------------------
# Lista de tickers separados por virgula. Maximo 4 sem BRAPI_TOKEN pago.
# Os 4 tickers abaixo sao os unicos que funcionam no plano gratis do brapi.
TICKERS=PETR4,VALE3,ITUB4,MGLU3

# ----------------------------------------------------------
# brapi.dev — cotacoes B3
# ----------------------------------------------------------
# Deixe VAZIO para usar o plano gratis (apenas PETR4, VALE3, ITUB4, MGLU3).
# Para monitorar outros tickers ou ter delay menor, assine o plano pago
# em https://brapi.dev e coloque seu token aqui.
BRAPI_TOKEN=

# ----------------------------------------------------------
# Telegram — notificacoes
# ----------------------------------------------------------
# Como obter:
#   BOT_TOKEN: fale com @BotFather no Telegram, crie um bot, copie o token.
#   CHAT_ID: envie /start pro seu bot, depois acesse:
#            https://api.telegram.org/bot<TOKEN>/getUpdates
#            O chat.id aparece na resposta JSON.
TELEGRAM_BOT_TOKEN=<obrigatorio>
TELEGRAM_CHAT_ID=<obrigatorio>

# ----------------------------------------------------------
# Anthropic — analise de noticias com Claude
# ----------------------------------------------------------
# Obtenha sua API key em https://console.anthropic.com
ANTHROPIC_API_KEY=<obrigatorio>

# Modelo usado para analise. claude-haiku-4-5-20251001 e recomendado (mais barato).
# Troque por claude-opus-4-5 se quiser analises mais detalhadas (custo ~20x maior).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------
# Agendamento
# ----------------------------------------------------------
# Horario do briefing diario (formato HH:MM, fuso BRT / America/Sao_Paulo)
BRIEFING_TIME=08:00

# ----------------------------------------------------------
# Posicao e gatilho de alerta por ativo
# ----------------------------------------------------------
# Formato:
#   <TICKER>_BUY_PRICE    — seu preco medio de compra (R$)
#   <TICKER>_ALERT_TRIGGER — quando disparar o alerta:
#     price:<valor>  — alerta quando cotacao <= valor absoluto (ex: price:42.00)
#     pct:<n>        — alerta quando cotacao <= buy_price * (1 - n/100)
#                      ex: pct:5 com buy=45.00 dispara quando cotacao <= 42.75
#
# Substitua os valores pelos seus dados reais.

# PETR4 — Petrobras PN
PETR4_BUY_PRICE=45.00
PETR4_ALERT_TRIGGER=price:42.00

# VALE3 — Vale ON
VALE3_BUY_PRICE=60.00
VALE3_ALERT_TRIGGER=pct:5

# ITUB4 — Itau Unibanco PN
ITUB4_BUY_PRICE=34.00
ITUB4_ALERT_TRIGGER=price:33.00

# MGLU3 — Magazine Luiza ON
MGLU3_BUY_PRICE=15.00
MGLU3_ALERT_TRIGGER=pct:10

# ----------------------------------------------------------
# Configuracoes avancadas (opcionais — defaults ja sao razoaveis)
# ----------------------------------------------------------
# Inicio e fim do pregao (BRT). O polling de cotacao so roda nessa janela.
# MARKET_OPEN=09:45
# MARKET_CLOSE=17:30

# Janela de deduplicacao de alertas (minutos).
# Um mesmo ativo nao dispara dois alertas dentro desse intervalo.
# ALERT_COOLDOWN_MINUTES=60

# Frequencia de coleta de noticias (minutos).
# NEWS_FETCH_INTERVAL_MINUTES=30

# Frequencia de polling de cotacao (minutos).
# QUOTE_POLL_INTERVAL_MINUTES=5

# Caminho do arquivo SQLite. No Docker, o compose ja injeta DB_PATH=/app/data/acoes_b3_monitor.db
# (dentro do volume b3_data) — NAO precisa setar aqui. So altere para rodar fora do Docker.
# DB_PATH=acoes_b3_monitor.db
